{% extends '@Admin/layout.html.twig' %}

{#
 # The drive's Google Drive in the back office (Base\Drive\Controller\Admin\DriveController):
 # where the files are, the Google account, the folder, the site's folders (when it lays some out).
 # A site restyles it in templates/bundles/DriveBundle/admin/drive.html.twig.
 #}
{% block page_title %}{{ '@messages.drive.admin.title'|trans }}{% endblock %}

{% block content_header %}
<div class="admin-header">
    <span class="admin-header-icon"><i class="fa-brands fa-google-drive"></i></span>
    <div class="admin-header-titles">
        <h1>{{ '@messages.drive.admin.title'|trans }}</h1>
        <div class="admin-header-subtitle">{{ '@messages.drive.admin.subtitle'|trans }}</div>
    </div>
</div>
{% endblock %}

{% block content %}
<style>
    .drive-admin { display: grid; gap: 1rem; max-width: 52rem; }
    .drive-admin .card { padding: 1.1rem 1.25rem; }
    .drive-admin h2 { font-size: 1rem; margin: 0 0 .6rem; }
    .drive-admin dl { display: grid; grid-template-columns: max-content 1fr; gap: .35rem 1.25rem; margin: 0; }
    .drive-admin dt { opacity: .7; } .drive-admin dd { margin: 0; font-weight: 600; }
    .drive-admin form { display: flex; flex-wrap: wrap; gap: .6rem; align-items: end; margin: 0; }
    .drive-admin label { display: grid; gap: .3rem; font-weight: 600; }
    .drive-admin .state { display: inline-flex; align-items: center; gap: .4rem; font-weight: 700; }
    .drive-admin .state::before { content: ""; width: .55rem; height: .55rem; border-radius: 50%; background: currentColor; }
    .drive-admin .is-on { color: #2d6a4f; } .drive-admin .is-off { color: #a8740f; }
    .drive-admin ol { margin: 0; padding-left: 1.2rem; }
</style>
<div class="drive-admin">
    {% block drive_where %}
    <div class="card">
        <h2>{{ '@messages.drive.admin.where'|trans }}</h2>
        <dl>
            <dt>{{ '@messages.drive.admin.storage'|trans }}</dt><dd><span class="state {{ onDrive ? 'is-on' : 'is-off' }}">{{ (onDrive ? '@messages.drive.admin.on_drive' : '@messages.drive.admin.on_site')|trans }}</span></dd>
            <dt>{{ '@messages.drive.admin.account'|trans }}</dt><dd>{{ settings.account ?? (settings.refreshToken ? '@messages.drive.admin.connected'|trans : '—') }}</dd>
            <dt>{{ '@messages.drive.admin.folder'|trans }}</dt><dd>{{ settings.folderName ?? '—' }}</dd>
        </dl>
        {% if error %}<p class="text-danger" style="margin:.75rem 0 0">{{ '@messages.drive.admin.google_says'|trans({message: error}) }}</p>{% endif %}
    </div>
    {% endblock %}

    {% block drive_connect %}
    {% if not configured %}
    <div class="card">
        <h2>{{ '@messages.drive.admin.setup_title'|trans }}</h2>
        <ol>
            <li>{{ '@messages.drive.admin.setup_console'|trans({url: 'https://console.cloud.google.com/apis/credentials'})|raw }}</li>
            <li>{{ '@messages.drive.admin.setup_redirect'|trans }} <code>{{ url('app_admin_drive_callback') }}</code></li>
            <li>{{ '@messages.drive.admin.setup_publish'|trans }}</li>
            <li>{{ '@messages.drive.admin.setup_env'|trans }}</li>
        </ol>
    </div>
    {% else %}
    <div class="card">
        <h2>{{ (settings.refreshToken ? '@messages.drive.admin.connected_title' : '@messages.drive.admin.connect_title')|trans }}</h2>
        {% if settings.refreshToken %}
            <form method="post" action="{{ path('app_admin_drive_disconnect') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('drive') }}">
                <button class="btn btn-outline-secondary" type="submit"><i class="fa-solid fa-link-slash"></i> {{ '@messages.drive.admin.disconnect'|trans }}</button>
            </form>
        {% else %}
            <a class="btn btn-primary" href="{{ path('app_admin_drive_connect') }}"><i class="fa-brands fa-google"></i> {{ '@messages.drive.admin.connect'|trans }}</a>
        {% endif %}
    </div>

    {% if settings.refreshToken %}
    <div class="card">
        <h2>{{ '@messages.drive.admin.folder_title'|trans }}</h2>
        <form method="post" action="{{ path('app_admin_drive_folder') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('drive') }}">
            <label>{{ '@messages.drive.admin.folder_pick'|trans }}
                <select class="form-select" name="folder">
                    <option value="new">{{ '@messages.drive.admin.folder_new'|trans }}</option>
                    {% for f in folders %}<option value="{{ f.id }}" {{ f.id == settings.folderId ? 'selected' }}>{{ f.name }}</option>{% endfor %}
                </select>
            </label>
            <label>{{ '@messages.drive.admin.folder_name'|trans }}<input class="form-control" name="name" placeholder="{{ '@messages.drive.admin.folder_default'|trans }}"></label>
            <button class="btn btn-primary" type="submit">{{ '@messages.drive.admin.folder_submit'|trans }}</button>
        </form>
    </div>
    {% endif %}
    {% endif %}
    {% endblock %}

    {% block drive_tree %}
    <div class="card">
        <h2>{{ (configured ? '@messages.drive.admin.tree_title_3' : '@messages.drive.admin.tree_title_2')|trans }}</h2>
        {% if tree %}
        <p>{{ tree.summary }} - {{ (onDrive ? '@messages.drive.admin.there_drive' : '@messages.drive.admin.there_site')|trans }}</p>
        {% endif %}
        <form method="post" action="{{ path('app_admin_drive_tree') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('drive') }}">
            {% if tree %}<button class="btn btn-primary" type="submit"><i class="fa-solid fa-folder-tree"></i> {{ '@messages.drive.admin.tree_submit'|trans }}</button>{% endif %}
            <a class="btn btn-outline-secondary" href="{{ path('app_share') }}"><i class="fa-solid fa-folder-open"></i> {{ '@messages.drive.admin.open'|trans }}</a>
        </form>
    </div>
    {% endblock %}
</div>
{% endblock %}
